+
+def write_delegation(path, **over):
+    now = time.time()
+    data = {"schema": "AUTO_DELEGATION_V1", "enabled": True, "repo_id": REPO_ID, "branch": "main", "projects": ["test-project"], "skills": ["test-skill"],
+            "policy": "POLICY-STATIC-V1", "enabled_at": iso(now - 60), "expires_at": iso(now + 30 * 86400), "max_request_usd": 1.0,
+            "max_day_calls": 2, "max_day_usd": 3.0, "max_month_usd": 10.0}
+    data.update(over)
+    for k in [k for k, v in data.items() if v is None]:
+        del data[k]
+    path.write_text(json.dumps(data), encoding="utf-8")
+    return data
+
+
+class CountingSigner(ToolSigner):
+    calls = 0
+
+    def sign(self, *a, **k):
+        type(self).calls += 1
