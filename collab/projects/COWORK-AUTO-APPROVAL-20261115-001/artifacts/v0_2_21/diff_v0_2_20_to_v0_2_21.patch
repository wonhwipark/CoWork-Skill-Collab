+def test_the_acl_rule_flags_every_broad_group_with_a_write_right():
+    EVERYONE, USERS, AUTH, ME = "S-1-1-0", "S-1-5-32-545", "S-1-5-11", "S-1-5-21-1-2-3-1001"
+    assert aces_allow_broad_write([(0, EVERYONE, 0x2)])                       # FILE_WRITE_DATA
+    assert aces_allow_broad_write([(0, USERS, 0x1301bf)])                     # modify
+    assert aces_allow_broad_write([(0, AUTH, 0x40000)])                       # WRITE_DAC
+    assert aces_allow_broad_write([(0, EVERYONE, 0x10000000)])                # GENERIC_ALL
+    assert not aces_allow_broad_write([(0, USERS, 0x1200a9)])                 # read and execute only
+    assert not aces_allow_broad_write([(0, ME, 0x1f01ff)])                    # the owner may write
+    assert not aces_allow_broad_write([(1, EVERYONE, 0x1f01ff)])              # a DENY entry is not a grant
+    assert not aces_allow_broad_write([])
