+def test_the_signed_payload_binds_exactly_the_published_bytes(auto):
+    info = make_request(auto.env.http)
+    auto.cycle()
+    approval = json.loads(remote(auto.env, REQ.format(rid="REQ-A") + "APPROVAL_SIG.json"))
