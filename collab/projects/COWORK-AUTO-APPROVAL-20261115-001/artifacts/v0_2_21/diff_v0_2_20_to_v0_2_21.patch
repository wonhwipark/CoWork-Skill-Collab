+def _zip(entries, corrupt=False):
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as zf:
+        for name, data in entries:
+            zf.writestr(zipfile.ZipInfo(name, date_time=(2026, 11, 1, 0, 0, 0)), data)
+    raw = buf.getvalue()
+    if corrupt:
+        i = raw.index(entries[0][1].encode() if isinstance(entries[0][1], str) else entries[0][1])
+        raw = raw[:i] + bytes([raw[i] ^ 0xFF]) + raw[i + 1:]
+    return raw
+
+
+@pytest.mark.parametrize("label, package", [
+    ("zip-slip", _zip([("../evil.txt", "x")])),
+    ("absolute path", _zip([("/abs.txt", "x")])),
+    ("secret-shaped text", _zip([("a.md", '{"refresh_token": "' + "a" * 40 + '"}')])),
+    ("corrupt CRC", _zip([("a.md", "design text that will be damaged")], corrupt=True)),
+    ("not a zip", b"this is not a zip file"),
+])
