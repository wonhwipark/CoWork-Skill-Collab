+def approval_posted(env, rid="REQ-A"):
+    return remote(env, REQ.format(rid=rid) + "APPROVAL_SIG.json") is not None
+
+
+def ready_posted(env, rid="REQ-A"):
+    return remote(env, REQ.format(rid=rid) + "READY.md") is not None
