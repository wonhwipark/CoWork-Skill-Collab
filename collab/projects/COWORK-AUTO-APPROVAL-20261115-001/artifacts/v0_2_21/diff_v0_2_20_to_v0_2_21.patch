+def direct(auto, rid, info, store=None, approver=None):
+    """Call the approver the way a cycle does: the transport has talked to the server first (that is where the server time comes from)."""
+    transport = make_transport(auto.env.http)
+    transport.ensure_auth()
+    return (approver or auto.approver).process(transport, store or auto.env.store, auto.policy, "/SKILL-COLLAB", rid, info.request.decode(), info.request).status
