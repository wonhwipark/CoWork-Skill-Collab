+def _reason_code(value: object) -> str:
+    text = str(value or "")
+    return text if re.fullmatch(r"[A-Z][A-Z0-9_]{0,79}", text) else "NOT_VERIFIED"
+
+
+def approval_wait_detail(request_id: str, revision: str, status: str, detail: str = "") -> str:
+    """Keep a bounded reason in the existing audit detail, never exception text.
+
+    Automatic approval does not invoke the model. This records only this step;
+    the total historical call count must be read from the existing receipts.
+    """
+    known_pin_error = re.search(r"\b(PIN_[A-Z_]+|REPO_ID_MISMATCH)\b", detail or "")
+    code = (_reason_code(known_pin_error.group(1)) if known_pin_error
+            else _reason_code(detail) if status == "PIN_MISMATCH" else _reason_code(status))
+    return json.dumps({"request_id": request_id, "revision": revision,
+                       "approval_stage": _reason_code(status), "reason_code": code}, sort_keys=True)
+
+
+def _wait_codes(detail: str | None) -> tuple[str, str]:
+    try:
+        data = json.loads(detail or "")
+    except (ValueError, TypeError):
+        data = {}
+    if not isinstance(data, dict):
+        data = {}
+    return _reason_code(data.get("approval_stage")), _reason_code(data.get("reason_code"))
+
+
+def _approval_action(stage: str, code: str) -> str:
+    if code.startswith("PIN_") or code == "REPO_ID_MISMATCH":
+        return "SOURCE_PIN 타입·고정 원본 검증"
+    if stage in ("UNCERTAIN", "SIGNING_UNCERTAIN", "DUPLICATE_OR_UNCERTAIN"):
+        return "기존 서명·호출 이력을 읽기 전용 정산"
+    if stage == "PER_REQUEST_COST":
+        return "기존 승인 금액과 실제 설치 정책 대조"
+    if stage in ("PRE_EXISTING_REQUEST", "RETROACTIVE_OR_FUTURE_REQUEST"):
+        return "소급 승인 제외 여부를 기존 기록과 대조"
+    if stage == "IN_PROGRESS":
+        return "진행 중인 기존 서명 결과 확인"
+    return "보호 위임·등록 정책과 해당 요청의 보류 기록 확인"
+
