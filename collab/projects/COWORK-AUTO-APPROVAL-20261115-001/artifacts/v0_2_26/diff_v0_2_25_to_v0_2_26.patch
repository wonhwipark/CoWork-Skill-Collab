+def _wait_superseded(conn: sqlite3.Connection, key: str | None) -> bool:
+    """Read existing rows only: a queued old wait must not follow READY/result."""
+    rid, revision = _split_key(key)
+    tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+    if "auto_claims" in tables:
+        row = conn.execute("SELECT stage FROM auto_claims WHERE request_id=? AND revision=?", (rid, revision)).fetchone()
+        if row and row[0] == "READY_POSTED":
+            return True
+    if "jobs" in tables:
+        rows = conn.execute("SELECT state FROM jobs WHERE request_id=? AND request_revision=?", (rid, revision))
+        if any(r[0] in {"CLAIMED", "REVIEW_RUNNING", "COMPLETED", "UPLOAD_FAILED", "REVIEW_UNCERTAIN", "FAILED"} for r in rows):
+            return True
+    return False
+
