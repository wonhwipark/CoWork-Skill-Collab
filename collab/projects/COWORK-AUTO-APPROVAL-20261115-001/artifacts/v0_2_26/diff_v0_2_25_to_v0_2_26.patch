+"""Precise wait reasons through the actual scan and injected, non-network sender."""
+import json
+
+from auto_helpers import auto, make_request, remote
+from fake_github import j, rp
+from skill_collab_watcher.notify_events import NotifyState, approval_wait_detail, build_message, run_once
+from skill_collab_watcher.state_store import StateStore
+
+
+def test_real_scan_records_pin_reason_instead_of_generic_ready_wait(auto):
+    make_request(auto.env.http)
+    path = "requests/REQ-A/SOURCE_PIN.json"
+    pin = json.loads(remote(auto.env, path))
+    pin["repo_id"] = 123456789
+    auto.env.http.commit({rp(path): j(pin)})
+    state = NotifyState()
+    state.bootstrap(auto.env.store.conn, "github", 1)
+    auto.cycle()
+    sent = []
+    assert run_once(auto.env.store.conn, state, provider="github", repo="owner/repo", send=sent.append) == 1
+    assert "REQ-A r1" in sent[0] and "PIN_REPO_ID_TYPE" in sent[0]
+    assert "SOURCE_PIN" in sent[0] and "이전 실행·누적 비용은 미확인" in sent[0]
+    assert "비용은 아직 0" not in sent[0]
+    auto.cycle()
+    assert run_once(auto.env.store.conn, state, provider="github", repo="owner/repo", send=sent.append) == 0
+
+
+def test_ready_published_does_not_log_a_stale_missing_ready_wait(auto):
+    make_request(auto.env.http)
+    state = NotifyState()
+    state.bootstrap(auto.env.store.conn, "github", 1)
+    auto.cycle()
+    sent = []
+    run_once(auto.env.store.conn, state, provider="github", repo="owner/repo", send=sent.append)
+    assert sent == []
+    assert auto.env.store.conn.execute("SELECT COUNT(*) FROM audit_log WHERE event='WAIT_INPUT'").fetchone()[0] == 0
+
+
+def test_old_queued_wait_is_suppressed_after_corrected_pin_reaches_ready(auto):
+    make_request(auto.env.http)
+    path = "requests/REQ-A/SOURCE_PIN.json"
+    valid = remote(auto.env, path)
+    pin = json.loads(valid)
+    pin["repo_id"] = 123456789
+    auto.env.http.commit({rp(path): j(pin)})
+    state = NotifyState()
+    state.bootstrap(auto.env.store.conn, "github", 1)
+    auto.cycle()
+    auto.env.http.commit({rp(path): valid})
+    auto.cycle()
+    sent = []
+    assert run_once(auto.env.store.conn, state, provider="github", repo="owner/repo", send=sent.append) == 0
+    assert sent == []
+
