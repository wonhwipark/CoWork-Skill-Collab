diff --git a/tests/test_v022_findings.py b/tests/test_v022_findings.py
--- a/tests/test_v022_findings.py
+++ b/tests/test_v022_findings.py
@@ -0,0 +1,340 @@
+"""v0.2.22 regressions for the GPT static findings on v0.2.21. Written against the PUBLIC flow only (the approver, the delegation file, the watcher's
+own audit events), so the same file runs against the old candidate (must FAIL where the finding is real) and the fixed one (must PASS).
+Synthetic data, throw-away key, fake GitHub. No model, no operating state."""
+from __future__ import annotations
+
+import json
+import threading
+import time
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from auto_helpers import auto, events, has, make_request, puts, remote, write_delegation  # noqa: F401
+from bundle import make_transport  # noqa: E402
+from fake_github import rp  # noqa: E402
+from skill_collab_watcher.state_store import StateStore  # noqa: E402
+from datetime import datetime as _dt, timezone as _tz, timedelta as _td
+
+
+def kst_window_starts(now):
+    """The KST day and month starts, computed here so the same test file collects on the old candidate too."""
+    kst = _tz(_td(hours=9))
+    t = _dt.fromtimestamp(now, kst)
+    day = t.replace(hour=0, minute=0, second=0, microsecond=0)
+    return int(day.timestamp()), int(day.replace(day=1).timestamp())
+
+
+def direct(auto_ns, rid, info):
+    transport = make_transport(auto_ns.env.http)
+    transport.ensure_auth()
+    return auto_ns.approver.process(transport, auto_ns.env.store, auto_ns.policy, "/SKILL-COLLAB", rid, info.request.decode(), info.request).status
+
+
+def watcher_dispatch(store, key, cost_usd, when=None):
+    """Exactly the audit rows the watcher writes for one paid review (dispatch with its cap, then the recorded cost)."""
+    store.log_event("REVIEW_DISPATCHED", processing_key=key, detail=json.dumps({"max_budget_usd": cost_usd}))
+    store.log_event("REVIEW_COST", processing_key=key, detail=json.dumps({"total_cost_usd": cost_usd}))
+
+
+def _kst_day(offset_days=0):
+    return kst_window_starts(int(time.time()))[0] + 3600 + offset_days * 86400
+
+
+# ================================ B1: one identity counts once, union of reservations and dispatches ==============================================
+
+def test_B1_auto_reservation_plus_a_separate_manual_dispatch_is_two_calls_and_the_third_is_refused(auto):
+    """A is reserved by automation, B was dispatched by the watcher, C would be the third distinct request in a day that allows two."""
+    a = make_request(auto.env.http, "REQ-A")
+    assert direct(auto, "REQ-A", a) == "READY_POSTED"
+    watcher_dispatch(auto.env.store, "REQ-B|1|bbb|1", 1.0)
+    c = make_request(auto.env.http, "REQ-C")
+    assert direct(auto, "REQ-C", c) != "READY_POSTED"
+    assert not (auto.env.http.files().get(rp("requests/REQ-C/READY.md")) is not None)
+
+
+def test_B1_a_restart_keeps_the_union(auto):
+    a = make_request(auto.env.http, "REQ-A")
+    direct(auto, "REQ-A", a)
+    watcher_dispatch(auto.env.store, "REQ-B|1|bbb|1", 1.0)
+    fresh = StateStore(auto.env.tmp / "state.sqlite3")
+    try:
+        usage = fresh.window_usage(int(time.time()))
+    finally:
+        fresh.close()
+    assert usage["day_calls"] == 2 and usage["day_cents"] == 200
+
+
+def test_B1_the_same_request_reserved_and_dispatched_counts_once(auto):
+    """Guard against over-correction: one identity must not be counted twice."""
+    a = make_request(auto.env.http, "REQ-A")
+    assert direct(auto, "REQ-A", a) == "READY_POSTED"
+    watcher_dispatch(auto.env.store, "REQ-A|1|aaa|1", 1.0)
+    usage = auto.env.store.window_usage(int(time.time()))
+    assert usage["day_calls"] == 1 and usage["day_cents"] == 100
+    c = make_request(auto.env.http, "REQ-C")
+    assert direct(auto, "REQ-C", c) == "READY_POSTED"
+
+
+def test_B1_cost_union_across_days_counts_both_costs_against_the_month_ceiling(auto):
+    """Two days, one month: A reserved on day 0 ($1), B dispatched by the watcher ($1) on day 0's clock, C on day 1 ($1). $3 > $2.5 monthly."""
+    write_delegation(auto.delegation, max_day_calls=2, max_day_usd=3, max_month_usd=2.5)
+    a = make_request(auto.env.http, "REQ-A")
+    assert direct(auto, "REQ-A", a) == "READY_POSTED"
+    watcher_dispatch(auto.env.store, "REQ-B|1|bbb|1", 1.0)
+    auto.now["offset"] = 86400                                                    # the next KST day, same month
+    c = make_request(auto.env.http, "REQ-C")
+    assert direct(auto, "REQ-C", c) != "READY_POSTED"
+    assert has(auto.env, "AUTO_LIMIT_BLOCKED", "MONTH_COST_LIMIT") or has(auto.env, "AUTO_NOT_ELIGIBLE", "MONTH_COST_LIMIT")
+
+
+def test_B1_an_earlier_kst_day_does_not_count_today(auto):
+    store = auto.env.store
+    store.ensure_auto_tables()
+    assert store.auto_claim("OLD", "1", "a" * 64, 100, "{}", _kst_day(-1), max_day_calls=1, max_day_cents=100, max_month_cents=1000) == "CLAIMED"
+    old_dispatch = (datetime.now(timezone.utc) - timedelta(hours=30)).isoformat()
+    store.conn.execute("INSERT INTO audit_log (ts, event, processing_key, detail) VALUES (?, 'REVIEW_DISPATCHED', 'OLD2|1|x|1', '{}')", (old_dispatch,))
+    usage = store.window_usage(int(time.time()))
+    assert usage["day_calls"] == 0 and usage["day_cents"] == 0
+
+
+def test_B1_concurrent_requests_respect_the_day_limit_under_the_union_rule(github_env):
+    github_env.store.ensure_auto_tables()
+    t = _kst_day()
+    outcomes, errors = [], []
+
+    def worker(i):
+        try:
+            store = StateStore(github_env.tmp / "state.sqlite3")
+            outcomes.append(store.auto_claim(f"R{i}", "1", "a" * 64, 100, "{}", t, max_day_calls=2, max_day_cents=900, max_month_cents=9000))
+            store.close()
+        except Exception as exc:                                                    # noqa: BLE001
+            errors.append(repr(exc))
+
+    threads = [threading.Thread(target=worker, args=(i,)) for i in range(6)]
+    [x.start() for x in threads]
+    [x.join() for x in threads]
+    assert not errors, errors
+    assert outcomes.count("CLAIMED") == 2 and outcomes.count("DAY_CALL_LIMIT") == 4
+
+
+def test_B1_watcher_dispatch_without_a_recorded_cost_counts_at_its_cap(auto):
+    store = auto.env.store
+    store.log_event("REVIEW_DISPATCHED", processing_key="REQ-B|1|bbb|1", detail=json.dumps({"max_budget_usd": 1.0}))
+    usage = store.window_usage(int(time.time()))
+    assert usage["day_calls"] == 1 and usage["day_cents"] == 100
+
+
+# ================================ B2: the protected delegation is re-decided before every signature and publication ===============================
+
+from skill_collab_watcher.auto_approval import AutoApprover, ToolSigner  # noqa: E402
+from bundle import REPO_ID  # noqa: E402
+from auto_helpers import iso  # noqa: E402
+
+
+def _narrow_at(monkeypatch, auto, hook_point, **change):
+    """Change the protected delegation at one exact boundary: before signing, right after the signature, or right after the approval was posted."""
+    if hook_point == "before_sign":
+        real = AutoApprover._sign_and_post
+
+        def hook(self, *a, **k):
+            write_delegation(auto.delegation, **change)
+            return real(self, *a, **k)
+        monkeypatch.setattr(AutoApprover, "_sign_and_post", hook)
+    elif hook_point == "after_sign":
+        real = ToolSigner.sign
+
+        def hook(self, *a, **k):
+            out = real(self, *a, **k)
+            write_delegation(auto.delegation, **change)
+            return out
+        monkeypatch.setattr(ToolSigner, "sign", hook)
+    elif hook_point == "after_approval":
+        real = AutoApprover._post_create_only
+
+        def hook(self, transport, path, data):
+            out = real(self, transport, path, data)
+            if path.endswith("APPROVAL_SIG.json"):
+                write_delegation(auto.delegation, **change)
+            return out
+        monkeypatch.setattr(AutoApprover, "_post_create_only", hook)
+
+
+@pytest.mark.parametrize("point", ["before_sign", "after_sign", "after_approval"])
+@pytest.mark.parametrize("change", [
+    {"projects": ["someone-else"]},                              # project removed from the owner's scope
+    {"skills": ["someone-else-skill"]},                          # skill removed
+    {"max_request_usd": 0.5},                                    # per-request ceiling lowered below the candidate's cost
+    {"enabled": False},                                          # switched off
+    {"expires_at": iso(time.time() - 5)},                        # expired
+    {"enabled_at": iso(time.time() + 3600)},                     # earliest request moved after this request was pinned
+    {"repo_id": "another-repository"},                           # policy identity changed
+])
+def test_B2_a_narrowed_delegation_stops_the_request_at_every_boundary(auto, monkeypatch, point, change):
+    info = make_request(auto.env.http, "REQ-A")
+    _narrow_at(monkeypatch, auto, point, **change)
+    direct(auto, "REQ-A", info)
+    claim = auto.env.store.auto_get_claim("REQ-A", "1")
+    assert claim is not None and claim["stage"] == "POLICY_STOPPED", (claim or {}).get("stage")
+    assert remote(auto.env, "requests/REQ-A/READY.md") is None, "no READY may follow a narrowed delegation"
+    assert auto.env.runner.calls == 0
+
+
+def test_B2_lowering_the_daily_call_limit_while_pending_stops_it(auto, monkeypatch):
+    other = make_request(auto.env.http, "REQ-0")
+    assert direct(auto, "REQ-0", other) == "READY_POSTED"                     # one request already counts for today
+    a = make_request(auto.env.http, "REQ-A")
