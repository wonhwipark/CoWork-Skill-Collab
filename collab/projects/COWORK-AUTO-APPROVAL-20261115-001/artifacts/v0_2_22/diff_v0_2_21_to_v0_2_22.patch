+def _wait_event(e2e, name, seconds=120):
+    """Wait for a watcher event in its database. Used instead of sleeps: a fixed sleep raced the child's start-up and lock acquisition."""
+    end = time.time() + seconds
+    while time.time() < end:
+        try:
+            if any(e == name for e, _ in e2e.events()):
+                return
+        except Exception:                                                  # the database may not exist yet
+            pass
+        time.sleep(0.3)
+    raise AssertionError(f"event {name} never appeared")
+
+
