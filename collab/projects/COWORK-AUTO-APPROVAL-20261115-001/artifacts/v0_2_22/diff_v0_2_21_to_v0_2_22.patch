+# ================================ M1 root cause: a second call during an in-flight signature must never sign again ==================================
+
+def test_M1_a_second_call_while_the_first_is_inside_the_signature_never_signs_again(auto, monkeypatch):
+    import threading as _threading
+    info = make_request(auto.env.http, "REQ-A")
+    entered, release = _threading.Event(), _threading.Event()
+    real_sign = ToolSigner.sign
+
+    def blocking_sign(self, *a, **k):
+        if not entered.is_set():
+            entered.set()
+            release.wait(30)
+        return real_sign(self, *a, **k)
+    monkeypatch.setattr(ToolSigner, "sign", blocking_sign)
+    first_status = {}
+
+    def first_call():
+        store = StateStore(auto.env.tmp / "state.sqlite3")                       # a SQLite connection belongs to its own thread
+        transport = make_transport(auto.env.http)
+        transport.ensure_auth()
+        first_status["s"] = AutoApprover(auto.settings, store, signer=auto.signer, now_fn=time.time, sleep=lambda _s: None).process(
+            transport, store, auto.policy, "/SKILL-COLLAB", "REQ-A", info.request.decode(), info.request).status
+        store.close()
+
+    thread = _threading.Thread(target=first_call)
+    thread.start()
+    assert entered.wait(30), "the first call never reached the signature"
+    second = direct(auto, "REQ-A", info)                                          # while the first one is still inside the signer
+    release.set()
+    thread.join(60)
+    assert second == "IN_PROGRESS", second
+    assert type(auto.signer).calls == 1
+    assert first_status.get("s") == "READY_POSTED"
+    assert len(puts(auto.env, "APPROVAL_SIG.json")) == 1
