+def kst_window_starts(now: int) -> tuple[int, int]:
+    """Epoch seconds of the start of the KST calendar day and of the KST calendar month containing `now`."""
+    t = datetime.fromtimestamp(now, KST)
+    day = t.replace(hour=0, minute=0, second=0, microsecond=0)
+    month = day.replace(day=1)
+    return int(day.timestamp()), int(month.timestamp())
