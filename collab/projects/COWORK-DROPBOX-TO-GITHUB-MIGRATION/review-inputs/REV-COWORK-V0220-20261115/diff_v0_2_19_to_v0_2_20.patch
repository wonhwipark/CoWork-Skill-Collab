     assert github_env.runner.calls == 2
+
+
+# --- R2 review of v0.2.19, BLOCKING finding: the repository id was cached for the life of a long-running transport ---------------
+
+def test_n2_the_identity_is_checked_again_on_every_approval_check_of_a_long_lived_transport(github_env):
+    from conftest import make_package_zip
+
+    shared = make_transport(github_env.http)                       # one transport object, as the real watch loop uses it
+    publish_bundle(github_env.http)
+    run(github_env, policy=github_policy(), transport=shared)
+    assert github_env.runner.calls == 1
+    github_env.http.repo_id = "the-repository-was-replaced"        # the name now points at another repository
+    publish_bundle(github_env.http, request_id="REQ-2", package=make_package_zip("second"))
+    run(github_env, policy=github_policy(), transport=shared)
+    assert github_env.runner.calls == 1, "a request approved for another repository must not be reviewed"
+    assert has_event(github_env.store, "APPROVAL_REPO_ID_REMOTE_MISMATCH")
