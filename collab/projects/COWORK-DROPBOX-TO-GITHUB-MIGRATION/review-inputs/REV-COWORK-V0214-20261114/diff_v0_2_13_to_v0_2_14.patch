+    assert len(sent) == 1 and "REQ-9" in sent[0]                    # one message, not three
+    s.close()
+
+
+def test_the_operating_watcher_folder_is_only_stat_checked_never_opened(e2e):
+    """The test never opens the operating database; it compares metadata before and after a full run."""
+    live = Path(os.environ.get("LOCALAPPDATA", "")) / "skill-collab-watcher"
