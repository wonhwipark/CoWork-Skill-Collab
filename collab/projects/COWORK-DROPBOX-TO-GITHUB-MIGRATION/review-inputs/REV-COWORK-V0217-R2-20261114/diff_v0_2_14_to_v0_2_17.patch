+    r"you['\u2019]ve hit your [^\n\u00b7|]{0,40}?limit|usage limit reached|(?:session|weekly|5-hour|five-hour|opus|sonnet) limit"
+    r"|out of (?:extra )?usage", re.IGNORECASE)
