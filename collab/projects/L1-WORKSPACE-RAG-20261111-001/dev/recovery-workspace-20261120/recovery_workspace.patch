+            record=self.k.load_record(wid);self.assertEqual('OPEN',record['state']);self.assertFalse(self.k._analysis_valid(wid,record))
+
+    def test_existing_registry_still_rejects_wrong_kind_or_source_provider(self):
+        self.assert_code('REGISTRY_MISMATCH',lambda:self.k.record_evidence(self.wid,self.source,'impact','analyze','l1-channel-recovery','1','synthetic','s'))
+        self.assert_code('REGISTRY_MISMATCH',lambda:self.k.record_evidence(self.wid,self.source,'recovery_analysis','utility','code-analyzer','1','synthetic','s'))
+
+    def test_embedded_json_provenance_cannot_disagree(self):
+        source=self.root/'report.json';source.write_text(json.dumps({'provider':'code-analyzer'}))
+        self.assert_code('RECOVERY_PROVENANCE_MISMATCH',lambda:self.preview(source=source))
+        source.write_text('{invalid');self.assert_code('RECOVERY_REPORT_INVALID',lambda:self.preview(source=source))
+
+    def test_invalid_formats_sizes_and_work_ids_are_rejected(self):
+        self.source.write_bytes(b'\xff');self.assert_code('RECOVERY_REPORT_INVALID',self.preview)
+        self.source.write_bytes(b'x'*(5*1024*1024+1));self.assert_code('RECOVERY_SIZE_INVALID',self.preview)
+        self.source.write_text('valid');link=self.root/'link.md';link.symlink_to(self.source)
+        self.assert_code('RECOVERY_SOURCE_INVALID',lambda:self.preview(source=link))
+        self.assert_code('RECOVERY_WORK_INVALID',lambda:self.k.work_recovery_reports('../outside'))
+
+    def test_export_links_digests_repeat_and_manual_document_preservation(self):
+        saved=self.save();docs=self.root/'docs';out=self.k.work_docs_export(str(docs),self.wid)
+        self.assertTrue(out['generation_complete']);work=docs/'works'/self.wid
+        projection=json.loads((work/'state/recovery_reports.json').read_text());item=projection['items'][0]
+        artifact=work/item['published_path'];self.assertEqual(saved['source_sha256'],hashlib.sha256(artifact.read_bytes()).hexdigest())
+        self.assertIn('RECOVERY.md',(docs/'README.md').read_text());self.assertIn('RECOVERY.md',(work/'README.md').read_text())
+        self.assertEqual(self.wid,json.loads((docs/'index/recovery.json').read_text())['items'][0]['work_id'])
+        self.assertNotIn('work_category',json.loads((work/'state/work_snapshot.json').read_text()))
+        before={str(p.relative_to(docs)):p.read_bytes() for p in docs.rglob('*') if p.is_file()}
+        self.k.work_docs_export(str(docs),self.wid)
+        self.assertEqual(before,{str(p.relative_to(docs)):p.read_bytes() for p in docs.rglob('*') if p.is_file()})
+        (work/'RECOVERY.md').write_text('manual note')
+        changed=self.k.work_docs_export(str(docs),self.wid)
+        self.assertEqual('manual note',(work/'RECOVERY.md').read_text());self.assertFalse(changed['generation_complete'])
+
+    def test_cross_host_export_preserves_existing_recovery_projection(self):
+        self.save();docs=self.root/'docs';self.k.work_docs_export(str(docs),self.wid)
+        k2=WorkLedgerKernel(self.root/'other-ledger',CONTRACTS);k2.new('SYNTHETIC-OTHER','BUG','Other')
