+from __future__ import annotations
+import hashlib
+import json
+import tempfile
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from work_ledger_kernel.kernel import WorkLedgerKernel
+from work_ledger_kernel.errors import KernelError
+from work_ledger_kernel.cli import main
+from contextlib import redirect_stdout
+from io import StringIO
+
+CONTRACTS = Path(__file__).resolve().parents[1] / 'contracts'
+
+
+class RecoveryReportsTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(); self.root = Path(self.temp.name)
+        self.k = WorkLedgerKernel(self.root/'ledger', CONTRACTS)
+        self.wid = 'SYNTHETIC-RECOVERY'; self.k.new(self.wid, 'BUG', 'Synthetic report')
+        self.source = self.root/'report.md'; self.source.write_text('# Recovery\nCovered: 1\nHOLD: 1\nRuntime: NOT_RUN\n')
+
+    def tearDown(self): self.temp.cleanup()
+
+    def preview(self, **kw):
+        return self.k.recovery_report_preview(self.wid, kw.get('source',self.source), 'unverified', kw.get('rev','git:synthetic:one'), kw.get('summary','Synthetic candidates'))
+
+    def save(self, preview=None, **kw):
+        p=preview or self.preview(**kw)
+        return self.k.record_recovery_report(self.wid, kw.get('source',self.source),'unverified',kw.get('rev','git:synthetic:one'),kw.get('summary','Synthetic candidates'),p['source_sha256'],p['evidence_revision'])
+
+    def assert_code(self, code, fn):
+        with self.assertRaises(KernelError) as e: fn()
+        self.assertEqual(code,e.exception.code)
+
+    def test_preview_and_read_leave_record_and_journal_unchanged(self):
+        before={p:p.read_bytes() for p in (self.root/'ledger').rglob('*') if p.is_file()}
+        self.assertFalse(self.preview()['saved']);self.assertEqual(0,self.k.work_recovery_reports(self.wid)['count'])
+        self.assertEqual(before,{p:p.read_bytes() for p in (self.root/'ledger').rglob('*') if p.is_file()})
+
+    def test_saved_copy_survives_run_cleanup_without_lifecycle_promotion(self):
+        saved=self.save(); self.source.unlink(); r=self.k.work_recovery_reports(self.wid)
+        self.assertEqual(1,r['count']);self.assertEqual('MATCH',r['items'][0]['integrity'])
+        self.assertEqual(saved['source_sha256'],r['items'][0]['sha256'])
+        self.assertEqual('OPEN',r['lifecycle_state']);self.assertFalse(saved['provider_executed'])
+        self.assertEqual('AUTO_CANDIDATE',r['items'][0]['confidence_state'])
+
+    def test_retry_reuses_exact_evidence_without_second_write(self):
+        p=self.preview();a=self.save(p);before=self.k.storage.record_path(self.wid).read_bytes()
+        b=self.save(p);self.assertEqual(a['evidence_id'],b['evidence_id']);self.assertEqual(0,b['created'])
+        self.assertEqual(before,self.k.storage.record_path(self.wid).read_bytes())
+        self.assertEqual(1,len(self.k.load_record(self.wid)['evidence_index']))
+
+    def test_new_revision_preserves_previous_report(self):
+        a=self.save();b=self.save(rev='git:synthetic:two')
+        self.assertNotEqual(a['evidence_id'],b['evidence_id']);self.assertEqual(2,self.k.work_recovery_reports(self.wid)['count'])
+
+    def test_changed_summary_cannot_reuse_existing_identity(self):
+        self.save();self.assert_code('EVIDENCE_ID_CONFLICT',lambda:self.save(summary='Different assertion'))
+
+    def test_changed_bytes_reject_stale_preview_without_record(self):
+        p=self.preview();self.source.write_text('changed')
+        self.assert_code('RECOVERY_PREVIEW_STALE',lambda:self.save(p));self.assertEqual(0,self.k.work_recovery_reports(self.wid)['count'])
+
+    def test_competing_evidence_requires_fresh_preview(self):
+        p=self.preview();self.save();self.source.write_text('another run')
+        p2=self.preview();p2['evidence_revision']=p['evidence_revision']
+        self.assert_code('EVIDENCE_REVISION_CONFLICT',lambda:self.save(p2))
+        self.assertEqual(1,self.k.work_recovery_reports(self.wid)['count'])
+
+    def test_tampered_original_is_visible_and_cannot_be_reused(self):
+        p=self.preview();saved=self.save(p);e=saved['evidence'];(self.k.storage.work_dir(self.wid)/e['path']).write_text('tamper')
+        self.assertEqual('SHA_MISMATCH',self.k.work_recovery_reports(self.wid)['items'][0]['integrity'])
+        self.assert_code('EVIDENCE_ID_CONFLICT',lambda:self.save(p))
+
+    def test_same_report_concurrent_retry_is_one_evidence(self):
+        p=self.preview()
+        with ThreadPoolExecutor(max_workers=2) as pool: results=list(pool.map(lambda _:self.save(p),range(2)))
+        self.assertEqual([0,1],sorted(r['created'] for r in results))
+        self.assertEqual(1,self.k.work_recovery_reports(self.wid)['count'])
+
+    def test_supplementary_report_does_not_satisfy_any_profile_analysis_gate(self):
